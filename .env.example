# ============================================================================
# SWAYAMBHU v2 - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ============================================================================

# Environment: 'development', 'test', 'staging', or 'production'
APP_ENV=development

# Vector Store: 'chroma' (local dev/test) or 'supabase' (production pgvector)
VECTOR_STORE_BACKEND=supabase
CHROMA_PERSIST_DIR=./data/chroma_db

# Supabase Credentials (Required if VECTOR_STORE_BACKEND=supabase or in production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Free LLM Provider Fallback Chain
LLM_PROVIDER_CHAIN=["groq", "google_gemma", "openrouter_llama", "openrouter_gemma", "ollama"]

# Free Cloud API Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Local Ollama: Default local endpoint (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Specific Free LLM Models
GOOGLE_GEMMA_MODEL=gemma-4-26b-a4b-it
OPENROUTER_GEMMA_MODEL=google/gemma-4-26b-a4b-it:free
PRIMARY_LLM_MODEL=groq/compound
OPENROUTER_LLAMA_MODEL=minimax/minimax-m3:free
OLLAMA_MODEL=llama3.2

# Embedding & Re-Ranking
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Speech-to-Text Transcription Hierarchy
WHISPER_CLOUD_PRIMARY=whisper-large-v3
WHISPER_CLOUD_FALLBACK=whisper-large-v3-turbo
LOCAL_WHISPER_GPU_MODEL=large-v3
LOCAL_WHISPER_CPU_MODEL=medium
WHISPER_DEV_MODE=false
