{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd premanand-ji-website && npm install && npx vite build",
  "outputDirectory": "premanand-ji-website/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://swayambhu-v2.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
